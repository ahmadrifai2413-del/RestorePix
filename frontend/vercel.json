{
  "framework": "vite",
  "buildCommand": "npm run build -- --outDir dist",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://restorepix.onrender.com/api/:path*"
    },
    {
      "source": "/studio",
      "destination": "/index.html"
    }
  ]
}